# OrthoFlow production secrets. Copy to `.env` on the server (never commit the
# real file) and fill in strong, unique values.
#   openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=https://ortho.crmbento.com
CORS_ALLOWED_ORIGINS=https://ortho.crmbento.com

# ── Voice: server-side speech-to-text (optional, off by default) ────────────
# Leave VOICE_STT_ENABLED unset/false to keep using the browser's own
# recognition. Setting it true routes captured consultation audio through the
# provider below and needs a DPA, a lawful basis and a CNDP notification
# (Law 09-08) first — same bar as the NLU fallback. The key stays on the
# server and is never sent to the browser. Get a key at https://console.groq.com.
VOICE_STT_ENABLED=false
VOICE_STT_API_KEY=
# whisper-large-v3-turbo (fastest/cheapest) | whisper-large-v3
VOICE_STT_MODEL=whisper-large-v3-turbo
# Any OpenAI-compatible /audio/transcriptions endpoint; point at a self-hosted
# faster-whisper server to keep audio on-premise.
VOICE_STT_BASE_URL=https://api.groq.com/openai/v1
